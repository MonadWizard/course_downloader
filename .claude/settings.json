{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx electron-builder*)",
      "Bash(npx electron . --cli*)",
      "Bash(graphify *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ffprobe *)",
      "Bash(~/.config/CourseGrab/bin/yt-dlp *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && [ -f graphify-out/graph.json ] && command -v graphify >/dev/null && graphify update . >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
