{
  "name": "course-downloader",
  "productName": "Course Downloader",
  "version": "0.1.0",
  "description": "Download single videos, playlists and full online courses (deeplearning.ai, YouTube, and more)",
  "main": "./out/main/index.js",
  "author": "Course Downloader",
  "license": "MIT",
  "homepage": "https://github.com/local/coursegrab",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "dist:linux": "npm run build && electron-builder --linux rpm AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "desktopName": "course-downloader.desktop"
}
